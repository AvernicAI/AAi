  "light": {
    "palette": {
      "neutral": "#f3f7e9",
      "ink": "#283e22",
      "primary": "#496b23",
      "accent": "#825820",
      "interactive": "#496b23",
      "success": "#2b7756",
      "warning": "#a56c21",
      "error": "#b94d50",
      "info": "#346e95",
